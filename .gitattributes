# 默认：Git 自动判断文本文件，入库时统一转 LF
* text=auto

# Python 源码强制 LF，避免 Windows 侧 checkout 出 CRLF（解决 ^M 问题的核心）
*.py text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf

# 生成物 / 缓存目录不参与导出
**/__pycache__/ export-ignore
**/*.pyc export-ignore
.venv/ export-ignore
.ruff_cache/ export-ignore
.pytest_cache/ export-ignore
typings/ export-ignore

# binary	等价于 -text -diff，不做换行转换、不做文本 diff
*.safetensors binary
*.bin binary
*.pt binary
*.png binary

# 大文本文件跳过 diff，提升 git diff 性能
uv.lock text eol=lf diff=false